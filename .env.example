# 复制为 .env 后修改（docker compose 自动读取，.env 不要提交）
APP_PASSWORD=workbench123
APP_TOKEN_SECRET=please-change-me-to-a-long-random-string

# MySQL（workbench-mysql 容器）
MYSQL_ROOT_PASSWORD=please-change-mysql-password
MYSQL_DATABASE=workbench

# Redis（未设密码时可保持注释）
# REDIS_PASSWORD=

# 允许的前端来源，逗号分隔；默认 * 放行所有来源，可收紧为 https://workbench.imhgl.com
# CORS_ALLOWED_ORIGINS=*
