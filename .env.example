# 复制为 .env 后修改（docker compose 自动读取；.env 不要提交）

# 登录密码哈希：必填。先生成密码，再取其 SHA-256 hex：
#   Linux:  echo -n '你的密码' | sha256sum
#   PowerShell: -join ([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes('你的密码')) | ForEach-Object { $_.ToString('x2') })
# 置空/删除并重启 = 关闭认证（密码遗失时的兜底）
AUTH_PASSWORD_SHA256=

# 可选：机器凭据（外部系统 ingest 上报时静态携带 X-API-Token；不用可留空）
API_TOKEN=

# 允许的前端来源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=https://workbench.imhgl.com