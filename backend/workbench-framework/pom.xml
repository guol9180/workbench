<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.imhgl</groupId>
        <artifactId>workbench-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>workbench-framework</artifactId>
    <name>workbench-framework</name>
    <description>Web 框架能力：全局异常 / 参数校验 / CORS / OpenAPI（零业务、零端点）</description>

    <dependencies>
        <dependency>
            <groupId>com.imhgl</groupId>
            <artifactId>workbench-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- Web MVC（Boot 4 新坐标 starter-webmvc；不可解析时回退 starter-web 并在提交信息注明） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 参数校验：jakarta validation（业务模块经本模块传递获得） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 接口文档：/v3/api-docs + Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
